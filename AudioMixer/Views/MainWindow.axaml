<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AudioMixer.ViewModels"
        xmlns:models="using:AudioMixer.Models"
        xmlns:svc="using:AudioMixer.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="AudioMixer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Root"
        Width="1296" Height="760"
        MinWidth="1120" MinHeight="760"
        MaxWidth="1824"
        Icon="/Assets/Mixer-Icon.ico"
        Background="{DynamicResource PageBackground}"
        Title="Audio Mixer">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!--
      Layout stability rules for this window:
      - Nothing is inserted or removed above the faders. Modes (calibration,
        settings) swap content inside fixed slots instead.
      - Controls that are unavailable are disabled, not hidden, so their space
        stays put.
      - The page switch sits in a centred column, so changing status text on
        either side never moves it.
    -->
    <Grid Margin="24,16,24,0" RowDefinitions="Auto,*,Auto">

        <!-- ===================== Top bar ===================== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Height="48" Margin="0,0,0,16">

            <!-- Device identity -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource Surface2}">
                    <Image Width="26" Height="26" Source="/Assets/Mixer-Icon.png"/>
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="h1" Text="{Binding DeviceName}"
                               TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    <TextBlock Classes="subtle" Text="{Binding DeviceInfo}"/>
                </StackPanel>
            </StackPanel>

            <!-- Page switch: standard segmented navigation -->
            <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="seg" Classes.selected="{Binding !IsSettingsOpen}"
                            Command="{Binding ShowMixerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xE9E9;" FontSize="14"/>
                            <TextBlock Text="Mixer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="seg" Classes.selected="{Binding IsSettingsOpen}"
                            Command="{Binding ShowSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xE713;" FontSize="14"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status (right-anchored) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Classes="chip accent" Padding="12,2,4,2"
                        IsVisible="{Binding IsFirmwareUpdateAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xE896;" FontSize="14"
                                   Foreground="{DynamicResource AccentText}"/>
                        <TextBlock Text="Update available" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <Button Classes="link" Content="Install"
                                Command="{Binding FlashFirmwareCommand}"
                                IsEnabled="{Binding !IsFlashing}"
                                ToolTip.Tip="{Binding FirmwareUpdateText}"/>
                    </StackPanel>
                </Border>

                <!-- Tint + dot + label: never colour alone -->
                <Border Classes="chip"
                        Classes.success="{Binding IsConnected}"
                        Classes.danger="{Binding !IsConnected}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel>
                            <Ellipse Classes="dot" Fill="{DynamicResource Success}"
                                     IsVisible="{Binding IsConnected}"/>
                            <Ellipse Classes="dot" Fill="{DynamicResource Danger}"
                                     IsVisible="{Binding !IsConnected}"/>
                        </Panel>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===================== Body: Mixer page / Settings page ===================== -->
        <Panel Grid.Row="1">

            <!-- ============ Mixer page ============ -->
            <Grid ColumnDefinitions="248,24,*" IsVisible="{Binding !IsSettingsOpen}">

                <!-- Playing now (secondary content) -->
                <Border Grid.Column="0" Classes="card">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="h2" Text="Playing now"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost iconbtn" Width="32" Height="32"
                                    Command="{Binding RescanCommand}" ToolTip.Tip="Refresh">
                                <TextBlock Classes="icon" Text="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Classes="subtle" Margin="0,4,0,16" TextWrapping="Wrap"
                                   Text="Apps making sound right now. Click a fader's target to assign one."/>
                        <ListBox Grid.Row="2" Classes="sessions" ItemsSource="{Binding Sessions}"
                                 Background="Transparent" BorderThickness="0" Margin="-8,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioSessionInfo">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="32" Height="32" CornerRadius="8"
                                                Background="{DynamicResource Surface2}">
                                            <Panel>
                                                <Image Width="22" Height="22" Source="{Binding Icon}"
                                                       IsVisible="{Binding HasIcon}"/>
                                                <TextBlock Text="🎵" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasIcon}"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Classes="body" Text="{Binding Label}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Faders (primary content). Window min width 1296 = exactly 5 faders
                     + Add (no gap after Add); max width 1824 = exactly 8 faders + Add. -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*">

                    <!-- Toolbar: fixed height. Calibration swaps its contents in place
                         rather than adding a banner that pushes the faders down. -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Height="40" Margin="0,0,0,16">
                        <Panel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding !IsCalibrating}">
                                <TextBlock Classes="h2" Text="Faders" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Surface2}" CornerRadius="999"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Faders.Count}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        IsVisible="{Binding IsCalibrating}">
                                <Border Classes="chip accent" Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Classes="dot" Fill="{DynamicResource AccentText}"/>
                                        <TextBlock Text="Calibrating" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Classes="body" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="Move each slider all the way down, then up."
                                           ToolTip.Tip="Move each slider all the way down, then all the way up. Audio stays put until you finish."/>
                            </StackPanel>
                        </Panel>

                        <Panel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding !IsCalibrating}">
                                <Button Classes="ghost" Command="{Binding StartCalibrationCommand}"
                                        ToolTip.Tip="Map each slider's real travel to a clean 0-100%">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="icon" Text="&#xE9E9;" FontSize="14"/>
                                        <TextBlock Text="Calibrate" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="primary" Command="{Binding SaveCommand}" MinWidth="96">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Classes="icon" Text="&#xE74E;" FontSize="14"/>
                                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding IsCalibrating}">
                                <Button Classes="ghost" Content="Cancel"
                                        Command="{Binding CancelCalibrationCommand}"/>
                                <Button Classes="primary" MinWidth="96"
                                        Command="{Binding FinishCalibrationCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Classes="icon" Text="&#xE73E;" FontSize="14"/>
                                        <TextBlock Text="Finish" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Panel>
                    </Grid>

                    <!-- Fader console -->
                    <!-- Fluent scrollbars draw over content, so the bottom margin
                         reserves a lane for the horizontal bar below the strips. -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding Faders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FaderViewModel">
                                        <Border Classes="fader" Classes.calibrating="{Binding IsCalibrating}"
                                                VerticalAlignment="Stretch">
                                            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

                                                <TextBlock Grid.Row="0" Classes="eyebrow" Text="{Binding Title}"
                                                           HorizontalAlignment="Center"/>

                                                <!-- Assign target: what this fader controls -->
                                                <Button Grid.Row="1" Classes="assign" Height="104"
                                                        Margin="0,8,0,16" ToolTip.Tip="Choose what this fader controls">
                                                    <StackPanel Spacing="8" VerticalAlignment="Center">
                                                        <Border Width="48" Height="48" CornerRadius="12"
                                                                Background="{DynamicResource Surface1}"
                                                                HorizontalAlignment="Center">
                                                            <Panel>
                                                                <Image Width="32" Height="32"
                                                                       Source="{Binding AssignedIcon}"
                                                                       IsVisible="{Binding HasAssignedIcon}"/>
                                                                <TextBlock Text="{Binding AssignedGlyph}" FontSize="20"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding !HasAssignedIcon}"/>
                                                            </Panel>
                                                        </Border>
                                                        <TextBlock Text="{Binding AssignedLabel}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                                   TextWrapping="Wrap" MaxWidth="112" MaxHeight="32"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout Placement="Bottom">
                                                            <Border Width="256" MaxHeight="360">
                                                                <ListBox ItemsSource="{Binding Options}"
                                                                         SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                         Background="Transparent" BorderThickness="0">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:AssignmentOption">
                                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                                <Image Width="24" Height="24" Source="{Binding Icon}"
                                                                                       IsVisible="{Binding HasIcon}"/>
                                                                                <TextBlock Text="{Binding Glyph}" FontSize="16"
                                                                                           Width="24" TextAlignment="Center"
                                                                                           IsVisible="{Binding !HasIcon}"/>
                                                                                <TextBlock Classes="body" Text="{Binding DisplayName}"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </Border>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>

                                                <!-- Level meter: full-height gradient revealed from the bottom,
                                                     with faint ticks at 25/50/75%. -->
                                                <Border Grid.Row="2" Width="28" MinHeight="120"
                                                        CornerRadius="10" ClipToBounds="True"
                                                        Opacity="{Binding BarOpacity}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                        Background="{DynamicResource TrackBackground}">
                                                    <Panel>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="{Binding UnfilledRow}"/>
                                                                <RowDefinition Height="{Binding FilledRow}"/>
                                                            </Grid.RowDefinitions>
                                                            <Rectangle Grid.Row="0" Grid.RowSpan="2"
                                                                       Fill="{DynamicResource FaderFill}"/>
                                                            <Rectangle Grid.Row="0" Fill="{DynamicResource TrackBackground}"/>
                                                        </Grid>
                                                        <Grid RowDefinitions="*,*,*,*" IsHitTestVisible="False">
                                                            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource MeterTick}"/>
                                                            <Border Grid.Row="1" BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource MeterTick}"/>
                                                            <Border Grid.Row="2" BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource MeterTick}"/>
                                                        </Grid>
                                                    </Panel>
                                                </Border>

                                                <!-- Live level -->
                                                <TextBlock Grid.Row="3" Classes="display" Text="{Binding VolumeLabel}"
                                                           Opacity="{Binding BarOpacity}"
                                                           HorizontalAlignment="Center" Margin="0,16,0,8"/>

                                                <!-- Fixed-height slot: mute button normally, captured
                                                     range while calibrating (no height change). -->
                                                <Panel Grid.Row="4" Height="36">
                                                    <Button Classes="mute" Classes.muted="{Binding IsMuted}"
                                                            VerticalAlignment="Stretch"
                                                            Command="{Binding ToggleMuteCommand}"
                                                            IsVisible="{Binding !IsCalibrating}"
                                                            ToolTip.Tip="Mute what this fader controls">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Classes="icon" Text="{Binding MuteGlyph}" FontSize="14"/>
                                                            <TextBlock Text="{Binding MuteLabel}" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Border CornerRadius="10" BorderThickness="1"
                                                            Background="{DynamicResource AccentSoft}"
                                                            BorderBrush="#408DB1FF"
                                                            IsVisible="{Binding IsCalibrating}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Classes="icon" Text="&#xE73E;" FontSize="12"
                                                                       Foreground="{DynamicResource Success}"
                                                                       IsVisible="{Binding IsCalibrationCaptured}"/>
                                                            <TextBlock Text="{Binding CalibrationRangeText}" FontSize="12"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AccentText}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Fader count controls beside the faders. Disabled (not hidden)
                                 while calibrating so the row keeps its width. -->
                            <Grid RowDefinitions="*,16,Auto" IsEnabled="{Binding !IsCalibrating}">
                                <Button Grid.Row="0" Classes="tile" VerticalAlignment="Stretch"
                                        Command="{Binding AddFaderCommand}" ToolTip.Tip="{Binding AddFaderTip}"
                                        ToolTip.ShowOnDisabled="True">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="icon" Text="&#xE710;" FontSize="20"/>
                                        <TextBlock Text="Add" FontSize="12" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Classes="tile" Height="48"
                                        Command="{Binding RemoveFaderCommand}" ToolTip.Tip="Remove the last fader">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="icon" Text="&#xE738;" FontSize="14"/>
                                        <TextBlock Text="Remove" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ============ Settings page ============
                 Windows-style settings: one card per section, each row is a
                 title + description on the left and its control on the right.
                 Connection changes apply and save immediately. Values stored on
                 the mixer have an Apply button that's only enabled when changed. -->
            <ScrollViewer IsVisible="{Binding IsSettingsOpen}" VerticalScrollBarVisibility="Auto">
                <!-- Fills the width; the right margin keeps the overlay scrollbar
                     off the controls. -->
                <StackPanel Spacing="8" Margin="0,0,20,24">

                    <!-- Connection -->
                    <TextBlock Classes="eyebrow" Text="CONNECTION" Margin="4,0,0,0"/>
                    <Border Classes="settings-card">
                        <StackPanel>
                            <Grid Classes="setting-row" ColumnDefinitions="*,24,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="Find the mixer automatically"/>
                                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                                               Text="Scans USB serial ports for the mixer and reconnects when you plug it in."/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding AutoDetect}"
                                              OnContent="On" OffContent="Off" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Classes="setting-row" ColumnDefinitions="*,24,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="Port"/>
                                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                                               Text="Used when automatic detection is off."/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" Width="320" VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailablePorts}"
                                          SelectedItem="{Binding SelectedPort}"
                                          IsEnabled="{Binding !AutoDetect}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="svc:SerialPortInfo">
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Classes="setting-row" ColumnDefinitions="*,24,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="Baud rate"/>
                                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                                               Text="Must match the firmware. The default is 9600."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBox Text="{Binding BaudRateText}" Width="120"/>
                                    <Button Content="Reconnect" Width="128"
                                            Command="{Binding ReconnectCommand}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Device -->
                    <TextBlock Classes="eyebrow" Text="MIXER" Margin="4,16,0,0"/>
                    <Border Classes="settings-card">
                        <StackPanel>
                            <Grid Classes="setting-row" ColumnDefinitions="*,24,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="Name"/>
                                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                                               Text="Saved on the mixer itself. Up to 15 characters."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBox Text="{Binding EditDeviceName}" Width="184" MaxLength="15">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding RenameDeviceCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Content="Apply" Width="128"
                                            Command="{Binding RenameDeviceCommand}"
                                            IsEnabled="{Binding IsNameDirty}"/>
                                </StackPanel>
                            </Grid>
                            <Border Classes="row-divider"/>
                            <Grid Classes="setting-row" ColumnDefinitions="*,24,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="Jitter filter"/>
                                    <TextBlock Classes="subtle" TextWrapping="Wrap"
                                               Text="{Binding HysteresisDescription}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Slider Width="136" Minimum="1" Maximum="32"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Hysteresis}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="8"
                                            Width="40" Padding="0,6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Hysteresis}" TextAlignment="Center"
                                                   Classes="body" FontWeight="SemiBold"/>
                                    </Border>
                                    <Button Content="Apply" Width="128"
                                            Command="{Binding ApplyHysteresisCommand}"
                                            IsEnabled="{Binding IsHysteresisDirty}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Firmware -->
                    <TextBlock Classes="eyebrow" Text="FIRMWARE" Margin="4,16,0,0"/>
                    <Border Classes="settings-card">
                        <Grid Classes="setting-row" ColumnDefinitions="*,24,Auto">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="row-title" Text="Mixer firmware"/>
                                    <Border Classes="chip accent" Padding="8,1"
                                            IsVisible="{Binding IsFirmwareUpdateAvailable}">
                                        <TextBlock Text="Update available" FontSize="12"
                                                   Foreground="{DynamicResource AccentText}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="subtle" Text="{Binding FirmwareVersionsText}"/>
                                <TextBlock Classes="subtle" TextWrapping="Wrap"
                                           Text="Writes the firmware bundled with this app to the connected mixer."/>
                            </StackPanel>
                            <!-- Fixed width; the label changes instead of text appearing beside it.
                                 It's the primary action on this page only when an update exists. -->
                            <Button Grid.Column="2" Width="160" VerticalAlignment="Center"
                                    Classes.primary="{Binding IsFirmwareUpdateAvailable}"
                                    Command="{Binding FlashFirmwareCommand}"
                                    IsEnabled="{Binding !IsFlashing}">
                                <Panel HorizontalAlignment="Center">
                                    <TextBlock Text="Install update" IsVisible="{Binding IsFirmwareUpdateAvailable}"/>
                                    <TextBlock Text="Reflash" IsVisible="{Binding !IsFirmwareUpdateAvailable}"/>
                                </Panel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Panel>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="2" Margin="-24,16,-24,0" Padding="24,10"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xE946;" FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Classes="subtle" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
